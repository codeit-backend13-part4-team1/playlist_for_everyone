# 이 파일을 .env.dev로 복사한 뒤, 개인 로컬 환경에 맞게 값을 채웁니다.
# .env.dev에는 실제 비밀번호 같은 개인 설정이 들어가므로 Git에 올리지 않습니다.

EVERYONE_SERVER_PORT=8080
EVERYONE_OPENAPI_SERVER_URL=https://your-domain.example.com

EVERYONE_AWS_REGION=ap-northeast-2
EVERYONE_AWS_ENDPOINT=
EVERYONE_S3_BUCKET=

EVERYONE_DB_HOST=localhost
# 다른 checkout 또는 기존 DB와 동시에 실행할 때는 사용하지 않는 포트로 변경합니다.
EVERYONE_DB_PORT=5432
EVERYONE_DB_NAME=everyone
EVERYONE_DB_USERNAME=everyone
EVERYONE_DB_PASSWORD=change-me

EVERYONE_JPA_DDL_AUTO=validate
EVERYONE_JPA_FORMAT_SQL=true
EVERYONE_JPA_SHOW_SQL=false
EVERYONE_FLYWAY_ENABLED=true
EVERYONE_DOCKER_COMPOSE_ENABLED=true

EVERYONE_REDIS_PORT=6379
EVERYONE_REDIS_HOST=localhost

EVERYONE_MULTIPART_MAX_FILE_SIZE=10MB
EVERYONE_MULTIPART_MAX_REQUEST_SIZE=12MB

# TMDB API Read Access Token
EVERYONE_TMDB_ACCESS_TOKEN=

# TheSportsDB API Key (공개 무료 키)
EVERYONE_SPORTSDB_API_KEY=123

# 알림 전용 실행기: 동시 실행 수는 1 이상, 대기열 크기는 0 이상이다. 0이면 대기열에 보관하지 않는다.
# 아래 값은 성능 측정 전 임시값이며 운영 적정값이 아니다.
# 작업 대기 시간·거부 횟수·DB 연결 대기를 측정한 뒤 조정한다.
EVERYONE_NOTIFICATION_ASYNC_POOL_SIZE=2
EVERYONE_NOTIFICATION_ASYNC_QUEUE_CAPACITY=100
# 알림 종료 대기의 초기값. 양수 Duration으로 지정하며, 제한 초과 시 미완료 작업의 완료를 보장하지 않는다.
EVERYONE_NOTIFICATION_ASYNC_SHUTDOWN_TIMEOUT=30s

# SSE: 하트비트 실행 완료 후 다음 실행까지의 간격. 15s처럼 Duration 형식으로 지정한다.
EVERYONE_SSE_HEARTBEAT_INTERVAL=15s
# SSE: 개별 연결의 제한 시간. 하트비트와 별도로 적용하며, 종료 후 클라이언트가 재연결한다.
EVERYONE_SSE_CONNECTION_TIMEOUT=30m
# SSE: 현재 지원하는 전송 방식. Redis 발행자와 수신자를 선택한다.
EVERYONE_SSE_TRANSPORT=redis
# SSE: 같은 환경의 서버끼리 공유하는 채널. 다른 환경은 Redis 또는 채널을 분리한다.
EVERYONE_SSE_REDIS_CHANNEL=everyone:sse:events
# SSE: 자동 구독 활성화. false는 SSE 구독만 끄며 Redis 전체를 비활성화하지 않는다.
EVERYONE_SSE_SUBSCRIPTION_ENABLED=true
EVERYONE_SSE_HISTORY_KEY_PREFIX=everyone:dev:sse:history
EVERYONE_SSE_HISTORY_MAX_EVENTS_PER_USER=1000
EVERYONE_SSE_HISTORY_RETENTION=10m
EVERYONE_SSE_RETRY_INITIAL_DELAY=1s
EVERYONE_SSE_RETRY_MAX_DELAY=30s
EVERYONE_SSE_RETRY_MAX_RETRIES=3

# 공통 WebSocket·SockJS 허용 Origin: 콘텐츠 시청·채팅과 DM이 함께 사용한다.
# dev는 미지정 시 http://localhost:<서버 포트>를 사용한다. prod는 반드시 주입해야 한다.
# http/https 주소와 필요한 포트만 지정한다. 경로·마지막 /·와일드카드·빈 값은 허용하지 않는다.
# HTTP 80·HTTPS 443 기본 포트는 생략하도록 정규화한다. 8080·8443 등 비기본 포트는 유지한다.
# 여러 Origin은 쉼표로 구분한다. 아래 예시를 주석 해제하거나 배포 환경변수로 주입한다.
# EVERYONE_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080
# 운영 예시: EVERYONE_WEBSOCKET_ALLOWED_ORIGINS=https://d3vqh3u26il5vi.cloudfront.net

# 공통 WebSocket 이벤트: true는 세션 무효화 등의 이벤트를 서버 간 전달한다.
# false는 단일 서버 내에서 처리한다. DM 전송 방식·채널과는 별도 설정이다.
EVERYONE_WEBSOCKET_EVENT_MULTIPLE=true

# DM WebSocket: 현재 지원하는 전송 방식은 redis이다.
EVERYONE_DM_WEBSOCKET_TRANSPORT=redis
# DM WebSocket: 이 서버의 DM 자동 구독만 제어한다. false여도 저장·발행과 다른 Redis 사용은 유지된다.
EVERYONE_DM_WEBSOCKET_SUBSCRIPTION_ENABLED=true
# DM WebSocket: 같은 환경의 서버는 같은 채널을 사용한다. 프로필별로 자동 분리되지 않는다.
# 다른 환경과 Redis를 공유하면 채널을 명시적으로 구분한다. 공통 이벤트 채널은 별도로 확인한다.
EVERYONE_DM_WEBSOCKET_REDIS_CHANNEL=everyone:dm:events
# 상세 설정: docs/conversation/10-websocket-settings.md

# Redis 명령 응답 대기 시간. 3s는 초기 적용값이며 시간 단위를 포함한다.
# 운영 지연과 타임아웃 발생률을 확인하여 환경별로 조정한다. 공용 Redis 사용처에 함께 적용된다.
EVERYONE_REDIS_TIMEOUT=3s

# JWT
# 로컬 개발 전용 키입니다.
# 운영 환경에서는 반드시 별도로 생성한 비밀 키를 환경변수로 주입합니다.
JWT_SECRET_KEY=bG9jYWwtZGV2LW9ubHkta2V5LTMyaXRlbS0wMDAwMDE=

# Access Token과 Refresh Token의 유효기간
JWT_ACCESS_TOKEN_VALIDITY=15m
JWT_REFRESH_TOKEN_VALIDITY=7d

# 로컬 HTTP 환경에서는 false를 사용한다.
JWT_REFRESH_COOKIE_SECURE=false

# 관리자 계정 초기화
# true로 설정하면 서버 시작 시 아래 이메일에 해당하는 계정을 확인한다.
EVERYONE_ADMIN_ENABLED=false

# 활성화할 때 세 값을 모두 입력한다.
# 실제 계정 정보는 로컬 환경 파일이나 배포 환경변수에만 설정한다.
EVERYONE_ADMIN_EMAIL=
EVERYONE_ADMIN_NAME=
EVERYONE_ADMIN_PASSWORD=

# 비밀번호 초기화 메일 발송 (기본값 Gmail SMTP)
EVERYONE_MAIL_HOST=
EVERYONE_MAIL_PORT=
EVERYONE_MAIL_USERNAME=
EVERYONE_MAIL_PASSWORD=

# 콘텐츠 정기 수집: 기본적으로 비활성화
EVERYONE_COLLECTION_SCHEDULE_ENABLED=false
EVERYONE_COLLECTION_SCHEDULE_ZONE=Asia/Seoul

# cron이 -이면 해당 수집은 예약하지 않는다.
EVERYONE_COLLECTION_SCHEDULE_TMDB_CRON=-
EVERYONE_COLLECTION_SCHEDULE_TMDB_MAX_PAGES=5

# 스포츠 예약을 사용할 때 리그 ID와 시즌을 입력한다.
EVERYONE_COLLECTION_SCHEDULE_SPORTSDB_CRON=-
EVERYONE_COLLECTION_SCHEDULE_SPORTSDB_LEAGUE_ID=
EVERYONE_COLLECTION_SCHEDULE_SPORTSDB_SEASON=
