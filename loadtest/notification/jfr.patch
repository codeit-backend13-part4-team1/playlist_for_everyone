+package com.codeit.sb13.playlist_for_everyone.domain.notification.monitoring;
+
+import jdk.jfr.Event;
+import jdk.jfr.Name;
+import jdk.jfr.StackTrace;
+
+import java.util.UUID;
+
+/** Local benchmark instrumentation for the synchronous playlist listener. */
+public final class PlaylistNotificationTiming implements AutoCloseable {
+
+    private static final ThreadLocal<TimingEvent> CURRENT = new ThreadLocal<>();
+    private final TimingEvent event;
+
+    private PlaylistNotificationTiming(UUID playlistId) {
+        event = new TimingEvent();
+        if (event.isEnabled()) {
+            event.playlistId = playlistId.toString();
+            CURRENT.set(event);
+            event.begin();
+        }
+    }
+
+    public static PlaylistNotificationTiming start(UUID playlistId) {
+        return new PlaylistNotificationTiming(playlistId);
+    }
+
+    public static void record(long elapsedNanos) {
+        TimingEvent current = CURRENT.get();
+        if (current != null) {
+            current.listenerCount++;
+            current.listenerNanos += elapsedNanos;
+        }
+    }
+
+    @Override
+    public void close() {
+        CURRENT.remove();
+        event.end();
+        event.commit();
+    }
+
+    @Name("everyone.PlaylistNotificationTiming")
+    @StackTrace(false)
+    static final class TimingEvent extends Event {
+        String playlistId;
+        int listenerCount;
+        long listenerNanos;
+    }
+}
